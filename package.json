{
  "name": "portfolio-roel",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@10.4.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "vitest run",
    "e2e": "playwright test",
    "check": "pnpm typecheck && pnpm lint && pnpm test",
    "shot": "tsx scripts/shot.ts",
    "sync:room": "node scripts/sync-room-assets.mjs",
    "shot:room": "node scripts/room-shots.mjs",
    "build:room": "node tools/room/build.mjs",
    "build:radio": "node tools/room/build-radio.mjs",
    "verify:room": "node tools/room/verify.mjs",
    "report:bundle": "vite build --manifest && node scripts/bundle-report.mjs"
  },
  "dependencies": {
    "@fontsource/silkscreen": "^5.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.2",
    "@gltf-transform/core": "4.5.1",
    "@gltf-transform/extensions": "4.5.1",
    "@gltf-transform/functions": "4.5.1",
    "@playwright/test": "1.62.1",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^6.1.2",
    "gltf-validator": "2.0.0-dev.3.10",
    "happy-dom": "^21.0.4",
    "meshoptimizer": "1.3.0",
    "sharp": "0.35.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
